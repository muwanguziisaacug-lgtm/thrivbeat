generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  phone         String?
  Exercise      Exercise[]
  Rating        Rating[]
  Subscription  Subscription[]
  accounts      Account[]
  Progress      Progress[]
  sessions      Session[]
  isAdmin       Boolean @default(false)

  @@map("user")
  Onboarding Onboarding[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Exercise {
  id           String         @id @default(uuid())
  title        String
  description  String
  thumbnailKey String         @unique
  videoKey     String         @unique
  duration     Int?
  level        ExerciseLevel  @default(Beginner)
  category     String
  calories     Int?
  plan         Plan
  status       ExerciseStatus
  equipments   Json?          @default("[]")
  steps        Json?          @default("[]")
  benefits     Json?          @default("[]")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  Rating       Rating[]
  Progress     Progress[]
  subscription Subscription[] @relation("ExerciseToSubscription")
}

model Rating {
  id         String   @id @default(uuid())
  value      Int
  ExerciseId String
  userId     String?
  createdAt  DateTime @default(now())
  Exercise   Exercise @relation(fields: [ExerciseId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])
}

model Progress {
  id         String   @id @default(uuid())
  userId     String
  ExerciseId String
  lessonId   String
  createdAt  DateTime @default(now())
  Exercise   Exercise @relation(fields: [ExerciseId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("progress")
}

model Support {
  id        String   @id @default(uuid())
  name      String
  subject   String
  createdAt DateTime @default(now())
  email     String
  message   String
}

model Subscription {
  id                   String             @id @default(uuid()) @map("_id")
  userId               String
  plan                 Plan
  period               SubscriptionPeriod
  stripeSubscriptionId String?            @unique
  startDate            DateTime
  endDate              DateTime?
  status               String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id])
  Exercise             Exercise[]         @relation("ExerciseToSubscription")

  @@unique([userId, plan])
}

model Onboarding {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String
  mainReason        String
  mainReasonOther   String?
  healthConditions  String[]
  medications       String?
  healthOther       String?
  programPreference String
  programPreferenceOther String?
  sessionsPerWeek   String
  sessionsPerWeekOther String?
  communityInterest String
  zoomInterest      String
  dataShareConsent  String
  supportNeeds      String?
  email             String?
  phone             String?
  country           String?
  currency          String?
  incomplete        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Emailsubscription {
  id      String @default(uuid())
  email   String @unique
}
  enum Plan {
    FREE
    PREMIUM
    BASIC
    STANDARD
  }

  enum SubscriptionPeriod {
    MONTHLY
    YEARLY
  }

  enum ExerciseStatus {
    Draft
    Published
    Archieved
  }

  enum ExerciseLevel {
    Beginner
    Intermediate
    Advanced
  }
